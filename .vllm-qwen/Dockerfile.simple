FROM python:3.11-slim-bullseye

# Set environment variables for GPU/CUDA
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    build-essential \
    cmake \
    pkg-config \
    ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Python packages for llama.cpp server
RUN pip install --no-cache-dir \
    llama-cpp-python \
    transformers \
    torch --index-url https://download.pytorch.org/whl/cpu \
    pydantic \
    fastapi \
    uvicorn \
    requests

# Download and compile llama.cpp with server support
RUN git clone https://github.com/ggerganov/llama.cpp.git /opt/llama.cpp && \
    cd /opt/llama.cpp && \
    make -j$(nproc) && \
    cp server /usr/local/bin/llama-server && \
    chmod +x /usr/local/bin/llama-server

# Set working directory
WORKDIR /workspace

# Expose port for llama-server
EXPOSE 8080

# Default command: run llama-server with Qwen model
ENTRYPOINT ["llama-server"]
CMD ["-hf", "unsloth/Qwen3.6-35B-A3B-MTP-GGUF:UD-Q4_K_M", "-ngl", "99"]
