FROM ubuntu:22.04

# Set environment variables for GPU/CUDA
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV PATH="/root/.unsloth/bin:$PATH"

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
    cmake \
    pkg-config \
    ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Verify curl is available
RUN which curl && curl --version

# Install unsloth.ai
RUN bash -c 'curl -fsSL https://unsloth.ai/install.sh | bash' || \
    echo "Warning: unsloth.ai install script failed, will install manually"

# Fallback: Install llama.cpp and dependencies manually
RUN python3 -m pip install --no-cache-dir \
    llama-cpp-python \
    transformers \
    torch --index-url https://download.pytorch.org/whl/cpu

# Set working directory
WORKDIR /workspace

# Expose port for llama-server (default 8080)
EXPOSE 8080

# Default command: run llama-server with Qwen3.6-35B-A3B-MTP-GGUF
# GPU acceleration will work with nvidia-docker or docker with --gpus flag
ENTRYPOINT ["llama-server"]
CMD ["-hf", "unsloth/Qwen3.6-35B-A3B-MTP-GGUF:UD-Q4_K_M"]
